{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build && node scripts/verify-worker-output.mjs",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "check:cloudflare": "node scripts/verify-worker-output.mjs",
    "deploy": "node scripts/deploy-cloudflare.mjs",
    "check:design": "node scripts/check-design-foundation.mjs",
    "check:public": "node scripts/check-public-pages.mjs && node scripts/check-quadratic-hero.mjs && node scripts/check-home-imagery.mjs && node scripts/check-home-subjects.mjs",
    "check:learning": "node scripts/check-learning.mjs",
    "check:conversion": "node scripts/check-conversion.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "check:math": "node scripts/check-math-typography.mjs",
    "check:branding": "node scripts/check-branding.mjs && node scripts/check-aurora.mjs",
    "check:readability": "node scripts/check-readability.mjs",
    "check:premium": "node scripts/check-premium-ui.mjs",
    "check:editorial": "node scripts/check-editorial-support.mjs",
    "check:publication": "node scripts/check-publication-boundaries.mjs",
    "check:focused": "node scripts/check-focused-labs.mjs",
    "check:focused-problems": "node scripts/check-focused-problems.mjs",
    "check:curricular-problems": "node scripts/check-curricular-problems.mjs",
    "report:answer-keys": "node scripts/generate-answer-key-queue.mjs",
    "audit:geometry": "node scripts/audit-geometry-curriculum.mjs",
    "audit:pedagogy": "node scripts/audit-pedagogy-alignment.mjs",
    "audit:answer-keys": "node scripts/generate-answer-key-queue.mjs",
    "check:public-copy": "node scripts/check-public-copy.mjs",
    "check:aurora": "node scripts/check-aurora.mjs",
    "check:hero": "node scripts/check-quadratic-hero.mjs",
    "qa:hero": "node scripts/qa-hero-browser.mjs",
    "check:home-imagery": "node scripts/check-home-imagery.mjs",
    "check:subjects": "node scripts/check-home-subjects.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "@types/katex": "^0.16.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "katex": "^0.19.0",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "json-rpc-2.0": "1.7.1",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
